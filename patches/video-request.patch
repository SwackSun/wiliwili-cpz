+    void refreshOutputQuality(bool season);
+    bool mediaListReady(bool season) const {
+        if (season) return !episodeList.empty() && episodeResult.id != 0;
+        return !videoDetailResult.pages.empty() && videoDetailPage.page > 0 &&
+               videoDetailPage.page <= videoDetailResult.pages.size();
+    }
+    int previousMediaPart(bool season) const {
+        if (season) {
+            auto i = episodeResult.index;
+            if (i > 0 && size_t(i) < episodeList.size() && episodeList[i-1].id) return int(i)-1;
+        } else if (videoDetailPage.page > 1) return int(videoDetailPage.page)-2;
+        return -1;
+    }
+    std::string previousCollectionVideo() const {
+        const auto& list = videoDetailResult.ugc_season;
+        for (int i = list.currentIndex-1; i >= 0 && size_t(i) < list.episodes.size(); --i)
+            if (!list.episodes[i].bvid.empty()) return list.episodes[i].bvid;
+        return {};
+    }
