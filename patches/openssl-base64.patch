+    auto padding = input.back() == '=' ? (input[input.size() - 2] == '=' ? 2 : 1) : 0;
+    if (input.find('=') < input.size() - padding)
+        return -1;
+    std::string decoded(input.size() / 4 * 3, '\0');
+    int length = EVP_DecodeBlock(reinterpret_cast<unsigned char*>(decoded.data()),
