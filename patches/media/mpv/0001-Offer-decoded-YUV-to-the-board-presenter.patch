--- /dev/null
+++ b/include/mpv/cm0_frame.h
@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+#pragma once
+#include <stdint.h>
+
+// Private render parameter for this board's libmpv. Return zero to let the
+// software renderer handle the frame normally. All pointers are borrowed.
+#include "render.h"
+struct mpv_cm0_frame {
+    int width, height;
+    int nv12, bt709, full_range;
+    uint8_t *const *planes;
+    const int *stride;
+    int src[4], dst[4]; // x0,y0,x1,y1 in video and SW target pixels
+};
+struct mpv_cm0_present {
+    int (*present)(const struct mpv_cm0_frame *);
+};
