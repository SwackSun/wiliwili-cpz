+void MineQrLogin::closeLcdLogin() {
+    const auto stack = brls::Application::getActivitiesStack();
+    if (cancel || stack.empty() || stack.back()->getContentView() != this) return;
+    cancel = true;
+    cm0::cancelLoginKey(oauthKey);
+    brls::Application::popActivity(brls::TransitionAnimation::NONE);
+}
+
+void MineQrLogin::onLoginSuccess() {
+    if (cm0::compactLayout()) closeLcdLogin();
+    else this->dismiss();
+}

