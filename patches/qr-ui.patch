+// One texel per module keeps the LCD code sharp when scaled to the panel height.
+static void setLcdLoginCode(QRImage* image, const std::string& url) {
+    const auto code = QrCode::encodeText(url.c_str(), QrCode::Ecc::LOW);
+    constexpr int border = 4;
+    const int size = code.getSize();
+    const int side = size + 2 * border;
+    std::vector<uint32_t> pixels(side * side, UINT32_MAX);
+    for (int y = 0; y < size; ++y)
+        for (int x = 0; x < size; ++x)
+            if (code.getModule(x, y)) pixels[(y + border) * side + x + border] = 0xff000000;
+    const int tex = nvgCreateImageRGBA(brls::Application::getNVGContext(), side, side, NVG_IMAGE_NEAREST,
+                                        reinterpret_cast<const unsigned char*>(pixels.data()));
+    image->setFreeTexture(true);
+    image->innerSetImage(tex);
+}
