-// 解析数据包
+// Decode one WebSocket message and all compressed packets within its budget.
+namespace {
+constexpr std::size_t headerSize = 16;
+constexpr std::size_t maxWireBytes = 4 * 1024 * 1024;
+constexpr std::size_t maxInflatedBytes = 16 * 1024 * 1024;
+constexpr std::size_t maxNotifications = 4096;
+constexpr unsigned maxInflateDepth = 4;
+
+bool inflatePacket(const uint8_t* data, std::size_t size, std::size_t& budget,
+                   std::vector<uint8_t>& output) {
+    z_stream stream{};
+    if (inflateInit(&stream) != Z_OK)
+        return false;
+    const std::unique_ptr<z_stream, decltype(&inflateEnd)> cleanup(&stream, inflateEnd);
+    stream.next_in = const_cast<Bytef*>(data);
+    stream.avail_in = static_cast<uInt>(size);
+
+    std::array<uint8_t, 16384> chunk;
+    for (;;) {
+        stream.next_out = chunk.data();
+        stream.avail_out = chunk.size();
+        const auto before = stream.avail_in;
+        const int status = inflate(&stream, Z_NO_FLUSH);
+        const auto produced = chunk.size() - stream.avail_out;
+        if (produced > budget)
+            return false;
+        budget -= produced;
+        output.insert(output.end(), chunk.begin(), chunk.begin() + produced);
+        if (status == Z_STREAM_END)
+            return stream.avail_in == 0;
+        if (status != Z_OK || (produced == 0 && stream.avail_in == before))
+            return false;
+    }
+}
+
+bool collectPackets(const uint8_t* data, std::size_t size, unsigned depth,
+                    std::size_t& budget, std::vector<std::string>& messages) {
+    while (size != 0) {
+        if (size < headerSize)
+            return false;
+        uint32_t wireLength, wireOperation;
+        uint16_t wireHeader, wireVersion;
+        std::memcpy(&wireLength, data, sizeof(wireLength));
+        std::memcpy(&wireHeader, data + 4, sizeof(wireHeader));
+        std::memcpy(&wireVersion, data + 6, sizeof(wireVersion));
+        std::memcpy(&wireOperation, data + 8, sizeof(wireOperation));
+
+        const std::size_t length = ntohl(wireLength);
+        const std::size_t header = ntohs(wireHeader);
+        if (header < headerSize || length < header || length > size)
+            return false;
+        if (ntohl(wireOperation) == 5) {
+            const auto* body = data + header;
+            const auto bodySize = length - header;
+            const auto version = ntohs(wireVersion);
+            if (version == 0) {
+                if (messages.size() == maxNotifications)
+                    return false;
+                messages.emplace_back(reinterpret_cast<const char*>(body), bodySize);
+            } else if (version == 2) {
+                std::vector<uint8_t> inflated;
+                if (depth >= maxInflateDepth || !inflatePacket(body, bodySize, budget, inflated) ||
+                    !collectPackets(inflated.data(), inflated.size(), depth + 1, budget, messages))
+                    return false;
+            }
+        }
+        data += length;
+        size -= length;
+    }
+    return true;
+}
+}  // namespace
